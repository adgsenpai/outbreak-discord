{
  "manifest_version": 3,
  "name": "Outbreak Discord Rich Presence",
  "version": "4.2.0",
  "description": "Outbreak File 1/2 Discord presence with all ten original stage artworks and live tracker.",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "https://outbreakweb.com/file1/*",
    "https://outbreakweb.com/file2/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://outbreakweb.com/file1/*",
        "https://outbreakweb.com/file2/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outbreakweb.com/file1/*",
        "https://outbreakweb.com/file2/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Outbreak Discord Presence"
  }
}
